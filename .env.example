# Copy to .env.local (git-ignored) and fill in real values. Placeholders only in this file.
# Variable set from docs/06-devops-guide.md §3.2. Additional variables are added in A4 (T0.3).

# Settings split is base/dev/prod (T0.3). Use .prod in deployed environments.
DJANGO_SETTINGS_MODULE=urbenmend.settings.dev
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# NOTE: the scheme is postgis://, not postgres:// — it is what selects the
# django.contrib.gis.db.backends.postgis engine when django-environ parses the URL.
DATABASE_URL=postgis://urbenmend:urbenmend@db:5432/urbenmend

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Idempotency windows for POST /reports (T2.3, BR-5, API §4.6). Our policy, not spec-derived —
# §4.6 says the retention window is deployment configuration, so these are the defaults, not a
# contract clients may depend on. Both are seconds, and they are deliberately far apart:
# IN_PROGRESS is the backstop for a request whose process died mid-write, RETENTION is how long a
# completed acknowledgement can be replayed. NOTE: these live in the Redis `default` cache, so
# flushing it drops every held key and an in-flight retry becomes a fresh submission.
IDEMPOTENCY_RETENTION_SECONDS=86400
IDEMPOTENCY_IN_PROGRESS_SECONDS=60
IDEMPOTENCY_KEY_MAX_LENGTH=255

STORAGE_ENDPOINT=http://storage:9000
STORAGE_BUCKET=urbenmend-media

# Photo upload limits (T2.4/T2.5, FR-7, API §6.4). Our policy, not spec-derived — FR-7 says
# "enforce size/type limits" without fixing numbers, so these are defaults, not a contract.
# MEDIA_ALLOWED_IMAGE_FORMATS holds Pillow format names and is matched against the *detected*
# format, never the client's Content-Type header.
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
MEDIA_MAX_DIMENSION=2048
MEDIA_THUMBNAIL_DIMENSION=320
MEDIA_IMAGE_QUALITY=82
MEDIA_MAX_PER_REPORT=5

# Submission rate limits (T2.9, FR-33, API §4.5). Our policy, not spec-derived — §4.5 requires
# "tighter buckets on … report submission" without fixing numbers. Syntax is `<count>/<n><unit>`
# with unit s|m|h|d, parsed by ScopedWindowRateThrottle (NOT by DRF, whose parser silently drops
# the count prefix). Deliberately separate from the AUTH_THROTTLE_RATE_* windows above: those are
# sized for credential guessing and would cut a citizen off after their fifth photo.
#   REPORT — per account, POST /reports. Also the per-account LLM cost ceiling (NFR-13).
#   MEDIA  — per account, POST /media. Higher, but NOT report×MEDIA_MAX_PER_REPORT: the upload is
#            the expensive endpoint, so it is the one that should bind first under photo-heavy load.
#   IP     — per source address, SHARED by both endpoints. The Sybil limit (PRD §T3); size it for
#            carrier NAT, since many citizens can share one address.
# NOTE: these counters live in the Redis `default` cache, so flushing it resets every window.
SUBMISSION_THROTTLE_RATE_REPORT=20/1h
SUBMISSION_THROTTLE_RATE_MEDIA=60/1h
SUBMISSION_THROTTLE_RATE_IP=120/1h

# Classification (T3.1–T3.3, FR-9/FR-10/FR-13a, NFR-13, Arch §6). Our numbers, not spec-derived —
# NFR-13 requires a token cap, a timeout and bounded retries without naming values.
#
# CLASSIFICATION_LLM_PROVIDER is a dotted path to an llm.LLMProvider subclass. ❓Q9 is resolved as
# *deferred*, so the default names UnconfiguredLLMProvider, which always raises: a deployment with
# nothing set here classifies through the FR-13a keyword fallback instead of failing (NFR-4). Leave
# it unset unless a provider has actually been chosen — and note P7 requires one that does not train
# on submitted data. A wrong path raises ImproperlyConfigured; it does NOT degrade silently.
CLASSIFICATION_LLM_PROVIDER=urbenmend.classification.llm.UnconfiguredLLMProvider
CLASSIFICATION_LLM_ENDPOINT=https://api.openai.com/v1
CLASSIFICATION_LLM_API_KEY=your-key-here
CLASSIFICATION_LLM_MODEL=gpt-4o-mini
CLASSIFICATION_LLM_MAX_OUTPUT_TOKENS=300
CLASSIFICATION_LLM_TIMEOUT_SECONDS=10.0
CLASSIFICATION_LLM_MAX_ATTEMPTS=2
CLASSIFICATION_LLM_BACKOFF_SECONDS=0.5
CLASSIFICATION_LLM_CACHE_SECONDS=86400
CLASSIFICATION_LLM_USER_RATE_LIMIT=20
CLASSIFICATION_LLM_GLOBAL_RATE_LIMIT=500
CLASSIFICATION_LLM_RATE_WINDOW_SECONDS=3600
CLASSIFICATION_LLM_DAILY_TOKEN_BUDGET=1000000
CLASSIFICATION_LLM_CIRCUIT_FAILURE_THRESHOLD=3
CLASSIFICATION_LLM_CIRCUIT_RECOVERY_SECONDS=60

# Confidence the keyword fallback reports on a match / on no match. ❓Q10 (the accuracy bar, and so
# the low-confidence review threshold) is OPEN — these are not tuned against a threshold that does
# not exist yet. The fallback's default severity band is deliberately NOT configurable; see
# classification/keywords.py DEFAULT_SEVERITY.
CLASSIFICATION_FALLBACK_MATCHED_CONFIDENCE=0.5
CLASSIFICATION_FALLBACK_UNMATCHED_CONFIDENCE=0.1
# Q10 is open. Leave blank to store confidence without flagging reports for review.
# CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=0.2

# Read by a concrete provider class, not by settings — unused while ❓Q9 stays deferred.
LLM_API_KEY=your-key-here
